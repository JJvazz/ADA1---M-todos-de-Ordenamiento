def ordenamiento_insercion(corredores):
    """
    Ordena una lista de diccionarios de corredores por su tiempo en segundos
    de menor a mayor utilizando el método de Inserción.
    """
    n = len(corredores)
    comparaciones = 0
    desplazamientos = 0

    # Empezamos desde el segundo elemento (índice 1), asumiendo que el primero ya está ordenado
    for i in range(1, n):
        actual = corredores[i]
        tiempo_actual = actual["tiempo_seg"]
        j = i - 1

        # Desplazamos hacia la derecha los elementos mayores al tiempo_actual
        while j >= 0:
            comparaciones += 1
            if corredores[j]["tiempo_seg"] > tiempo_actual:
                corredores[j + 1] = corredores[j]
                desplazamientos += 1
                j -= 1
            else:
                break

        # Insertamos el elemento en su posición correcta
        corredores[j + 1] = actual

    return corredores, comparaciones, desplazamientos


def formatear_tiempo(segundos):
    minutos = segundos // 60
    seg_restantes = segundos % 60
    return f"{minutos:02d}:{seg_restantes:02d} min ({segundos}s)"


def imprimir_tabla(titulo, lista):
    print(f"\n--- {titulo} ---")
    for pos, c in enumerate(lista, start=1):
        print(f"  #{pos} | Dorsal {c['dorsal']} - {c['nombre']:<16} | Tiempo: {formatear_tiempo(c['tiempo_seg'])}")


