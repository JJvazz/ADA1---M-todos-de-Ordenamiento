def ordenamiento_seleccion(inventario):
    """
    Ordena una lista de listas [codigo, producto, precio] de menor a mayor precio
    utilizando el algoritmo de Selección.
    """
    n = len(inventario)
    comparaciones = 0
    intercambios = 0

    for i in range(n - 1):
        # Suponemos que el primer elemento no ordenado es el mínimo
        indice_minimo = i

        # Buscamos el verdadero mínimo en el resto de la lista
        for j in range(i + 1, n):
            comparaciones += 1
            if inventario[j][2] < inventario[indice_minimo][2]:
                indice_minimo = j

        # Solo intercambiamos si encontramos un elemento menor en otra posición
        if indice_minimo != i:
            inventario[i], inventario[indice_minimo] = inventario[indice_minimo], inventario[i]
            intercambios += 1

    return inventario, comparaciones, intercambios


def mostrar_catalogo(titulo, productos):
    print(f"\n--- {titulo} ---")
    for sku, nombre, precio in productos:
        print(f"  [{sku}] {nombre:<26} | ${precio:>8,.2f} MXN")


if __name__ == "__main__":
    # Inventario desordenado: [SKU, Nombre del producto, Precio en MXN]
    catalogo_tienda = [
        ["HW-01", "Monitor IPS 24 pulgadas", 3299.00],
        ["HW-02", "Cable HDMI 2.1 Trenzado", 249.50],
        ["HW-03", "Teclado Mecánico RGB", 1150.00],
