        ["HW-05", "SSD NVMe 1TB PCIe 4.0", 1690.00],
        ["HW-06", "Mouse Inalámbrico Óptico", 420.00]
    ]

    print("====================================================")
    print("   TIENDA TECH - ORDENAMIENTO POR SELECCIÓN")
    print("====================================================")

    mostrar_catalogo("CATÁLOGO ORIGINAL (SIN ORDENAR)", catalogo_tienda)

    # Clonamos sublistas para no alterar el arreglo original
    copia_catalogo = [item.copy() for item in catalogo_tienda]
    catalogo_ordenado, total_comp, total_inter = ordenamiento_seleccion(copia_catalogo)

    mostrar_catalogo("CATÁLOGO ORDENADO (PRECIO: MENOR A MAYOR)", catalogo_ordenado)

    print(f"\n[Métricas] Comparaciones realizadas: {total_comp} | Intercambios físicos: {total_inter}")
    print(f"[Oferta] Artículo más económico: {catalogo_ordenado[0][1]} (${catalogo_ordenado[0][2]:,.2f} MXN)")
